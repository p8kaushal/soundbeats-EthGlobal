# Artist upload API for https://arc.ethglobal.soundbeats.io (/api/*). Installed by deploy/install.sh.
[Unit]
Description=SoundBeats Releases artist upload API (S3 + Arc + Arkiv)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/soundbeats-releases/releases-api
# Same Arkiv writer wallet as the photo-to-music app. The key stays on this server.
EnvironmentFile=/home/ubuntu/secrets/arkiv.env
Environment=PORT=3300
Environment=AWS_REGION=ap-northeast-1
Environment=MEDIA_BUCKET=soundbeats-ethglobal-media-20261106
Environment=MEDIA_PREFIX=artist_uploads
Environment=DATA_DIR=/home/ubuntu/releases-api-data
Environment=PUBLIC_BASE_URL=https://arc.ethglobal.soundbeats.io
Environment=NODE_NO_WARNINGS=1
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target

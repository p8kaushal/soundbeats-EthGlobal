# Copy to .env (never commit .env). Load it before `npm start`, e.g.:  set -a; . ./.env; set +a

# Google Gemini key for live Lyria generation (not needed for demo mode).
GEMINI_API_KEY=

# For a private demo before World is connected, explicitly set false.
# Omit or set true to require World verification for live generation.
REQUIRE_WORLD_VERIFICATION=true

PORT=3000
NODE_ENV=production
PUBLIC_BASE_URL=https://ethglobal.soundbeats.io/game

# World Agent Pass / OpenID Connect (optional: live generation only requires World when the secret is set).
WORLD_CLIENT_ID=57dbfe35-6a2b-478e-ac11-1d2f4230750d
WORLD_CLIENT_SECRET=
WORLD_ISSUER=https://auth.world.org
WORLD_REDIRECT_URI=https://ethglobal.soundbeats.io/api/auth/world/callback

# Arkiv Rabdi testnet. Keep both values on the server.
ARKIV_PRIVATE_KEY=
ARKIV_ACCESS_KEY=

# Optional sub-path when served behind nginx, e.g. /game  ->  https://<domain>/game/
BASE_PATH=

# Private SoundBeats beatmap engine (separate service, not in this repo).
# On the hackathon server: http://127.0.0.1:4100
# From your laptop: open an SSH tunnel first (see docs/BEATMAP_INTEGRATION.md), then use the same URL.
BEATMAP_ENGINE_URL=http://127.0.0.1:4100
BEATMAP_ENGINE_TOKEN=

# Set to 1 to use placeholder beatmaps when the engine is unavailable (UI work only).
BEATMAP_ENGINE_MOCK=0

# "Play in SoundBeats" links (see docs/PLAY_IN_GAME.md)
# Public HTTPS address phones can reach, including BASE_PATH, e.g. https://ethglobal.soundbeats.io/game
# Leave empty for local testing (links will say localhost).
PUBLIC_BASE_URL=
# App URL scheme registered by the iOS game.
GAME_URL_SCHEME=soundbeats
# Public TestFlight invite link, shown when the game isn't installed.
TESTFLIGHT_URL=

# Arc payments (docs/ARC_PAYMENTS.md). Keep the publisher key in ~/secrets/arc.env, never in git.
ARC_PUBLISHER_KEY=
ARC_PAYOUT_WALLET=0xE4bd45C71e54f851d0c0349339B2aEDA551b7f49
ARC_PRICE_USDC=1.5
